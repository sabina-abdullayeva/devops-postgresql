[Unit]
Description=PostgreSQL Exporter
After=network.target postgres-custom.service
Requires=postgres-custom.service

[Service]
Type=simple
User={{ postgres__exporter_user }}
Group={{ postgres__exporter_user}}
Environment="DATA_SOURCE_NAME=user={{ postgres__exporter_user }} host=/var/run/postgresql dbname=postgres sslmode=disable"
ExecStart=/usr/local/bin/postgres_exporter --web.listen-address=127.0.0.1:{{ postgres__exporter_port }}
Restart=on-failure

[Install]
WantedBy=multi-user.target
