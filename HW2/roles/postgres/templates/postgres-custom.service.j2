[Unit]
Description=Custom PostgreSQL Server
After=network.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart={{ __postgres_bin_dir }}/postgres -D {{ postgres__data_dir }}
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
TimeoutStopSec=120
Restart=on-failure


[Install]
WantedBy=multi-user.target
